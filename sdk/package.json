{
  "name": "@puddleswap/sdk",
  "version": "0.1.0",
  "description": "Wallet-agnostic quoting and transaction helpers for PuddleSwap",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run",
    "example:quote": "node examples/quote.mjs"
  },
  "dependencies": {
    "viem": "^2.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "~5.7.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
