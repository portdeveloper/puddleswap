FROM ghcr.io/foundry-rs/foundry:stable

USER root

RUN set -eux; \
  if command -v apt-get >/dev/null 2>&1; then \
    apt-get update; \
    apt-get install -y --no-install-recommends jq ca-certificates git curl; \
    rm -rf /var/lib/apt/lists/*; \
  elif command -v apk >/dev/null 2>&1; then \
    apk add --no-cache jq ca-certificates bash git curl; \
  else \
    echo "No supported package manager found (apt-get/apk)"; \
    exit 1; \
  fi

WORKDIR /app

COPY config ./config
COPY contracts ./contracts
COPY scripts ./scripts
COPY Makefile ./

RUN cd /app/contracts && forge install --no-git \
  foundry-rs/forge-std@v1.15.0 \
  OpenZeppelin/openzeppelin-contracts@v5.6.1 \
  Uniswap/v2-core \
  Uniswap/v2-periphery \
  Uniswap/solidity-lib

RUN chmod +x /app/scripts/*.sh && mkdir -p /app/contracts/broadcast /app/contracts/cache \
  && adduser --disabled-password --gecos "" --home /app rebalancer && chown -R rebalancer:rebalancer /app

ENV RPC_URL=https://testnet-rpc.monad.xyz
ENV TARGET_STABLE_PER_WMON=100000000
ENV TARGET_TOLERANCE_BPS=50
ENV MAX_INPUT_FRACTION_BPS=5000
ENV REBALANCE_INTERVAL_SECONDS=300
ENV REBALANCE_JITTER_SECONDS=30

USER rebalancer
# Rebalancer retired; this image now runs the read-only pool health reporter.
CMD ["bash", "/app/scripts/pool-health-reporter.sh"]
